@{
    ViewBag.Title = "Sidebar Link";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
}

<script src="~/scripts/myjslib/SidebarLinkController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" ng-model="hfIconpath" id="Iconpath" name="Iconpath" value="" />
<div class="app-content  my-3 ">
    <div class="side-app">
        <div class="autohide-scroll autoheightset">

            <div class="br-pageheader">
                <!-- Title -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
                    <h5 class="txt-dark"> @ViewBag.Title</h5>
                </div>
                <!-- Breadcrumb -->
                <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
                    <ol class="breadcrumb">
                        <li><span>Unit Manager</span></li>
                        <li class="breadcrumb-item">Unit Detail Master</li>
                        <li class="active"><span>@ViewBag.Title</span></li>
                    </ol>
                </div>

            </div>

            <div class="br-pagebody">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                            <div class="refresh-container">
                                <div class="preloader">
                                    <div class="circles-1">
                                        <div class="circles-1-center"></div>
                                        <div class="circles-1"></div>
                                        <div class="circles-1"></div>
                                        <div class="circles-1"></div>
                                        <div class="circles-1"></div>
                                        <div class="circles-1"></div>
                                        <div class="circles-1"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="panel-wrapper ">
                                <div class="panel-body">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="collapse in">
                                            <form id="user-form">
                                                <div class="section-toggle">
                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding">
                                                        @*<div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                                            <div class="form-group">
                                                                <label>Images  Upload</label>
                                                                <input type="file" accept="image/jpg,image/png,image/jpeg" id="fileInput" onchange="angular.element(this).scope().show(this)" ng-model="fileInput" multiple class="form-control clear validate" />
                                                            </div>
                                                            <div>
                                                                <strong>Instructions to Upload Files</strong>
                                                                <ul>
