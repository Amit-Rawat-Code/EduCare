    <script>
        $(window).ready(function FindWindow() {

            var InW = $(window).width();
            var InH = $(window).height();

            var IfSetHeight;
            if (InW > 1024) {
                IfSetHeight = InH - 126;
                $('.iframe-wrapper').find('.iframedesign ').css({ "height": IfSetHeight });
            }
            else {
                IfSetHeight = InH - 132;
                $('.iframe-wrapper').find('.iframedesign ').css({ "height": IfSetHeight });
                //$('.iframe-wrapper').find('.iframedesign ').css({ "width": InW });
            }
            $('input').removeAttr('readonly');
        });

        $(window).on('resize', function () {
            var InW = $(window).width();
            var InH = $(window).height();

            var IfSetHeight;
            if (InW > 1024) {
                IfSetHeight = InH - 126;
                $('.iframe-wrapper').find('.iframedesign ').css({ "height": IfSetHeight });
            }
            else {
                IfSetHeight = InH - 132;
                $('.iframe-wrapper').find('.iframedesign ').css({ "height": IfSetHeight });
                //$('.iframe-wrapper').find('.iframedesign ').css({ "width": InW });
            }
            $('input').removeAttr('readonly');
        })
    </script>
    <style>
        div#ModalSwitchSchool {
            padding: 5px !important;
        }

        .school-switch-modal .design-part {
            display: table;
            width: 100%;
        }

        .school-switch-modal .modal-footer {
            background: #4680ff;
            margin-top: -5px;
            padding: 15px 30px;
            text-align: left;
        }

        .school-switch-modal .form-panel .form-panel-heading {
            font-size: 12px;
        }

        .school-switch-modal .form-panel .form-panel-heading {
            font-size: 12px;
            font-weight: 500;
        }

        .school-switch-modal .modal-title {
            font-size: 14px;
            text-align: center;
        }

        .school-switch-modal img.current-login-logo {
            height: 75px;
            margin: 0 auto;
            display: table;
            margin-bottom: 15px;
        }

        .school-switch-modal h3.current-login-title {
            font-size: 14px;
            margin: 0px;
            color: #606060;
            font-weight: 400;
            text-align: center;
            line-height: 18px;
        }

        .school-switch-modal h3.current-login-sub-title {
            font-size: 14px;
            margin: 0px;
            color: #4680ff;
            font-weight: 400;
        }

        div#ModalSwitchSchool .modal-dialog.modal-lg {
            max-width: 550px;
            margin: 0 auto;
        }

        .school-switch-modal .school-details h3.current-login-title span {
            font-weight: 500;
            color: #666;
            display: inline-block;
            padding: 0px 5px;
        }

        .school-switch-modal .school-details h3.current-login-title {
            font-size: 12px;
            color: #1453dd;
            font-weight: 500;
            line-height: 18px;
        }

        .panel-shadow {
            box-shadow: rgb(135, 135, 135) 0px 2px 10px -1px;
        }

        .row.switch-icon-fit {
            position: relative;
        }

            .row.switch-icon-fit svg {
                position: absolute;
                left: 50%;
                height: 20px !important;
                width: 20px !important;
                top: 50%;
                transform: translate(-50%, -50%);
            }

        .school-switch-modal .form-panel {
            margin: 0px 0px 25px 0px;
        }

        .school-switch-modal .school-details h3.current-login-title.branch-address {
            min-height: 40px;
        }

        .school-switch-modal .row.form-panel-body {
            margin-top: -25px;
        }

        .school-switch-modal .modal-body {
            padding-bottom: 0px;
            padding-top: 22px;
        }

        @@media only screen and (max-width: 767px) {
            .row.switch-icon-fit {
                position: relative;
                flex-direction: column;
            }

                .row.switch-icon-fit .form-panel.panel-shadow .row.form-panel-body {
                    flex-direction: column;
                }

                .row.switch-icon-fit svg {
                    margin-top: -13px;
                }
        }
    </style>

</head>
